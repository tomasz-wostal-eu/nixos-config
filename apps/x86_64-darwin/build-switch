#!/bin/sh -e
# shellcheck disable=SC2034,SC2068  # inherited template script, behaviour kept as is

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

SYSTEM_TYPE="x86_64-darwin"
FLAKE_SYSTEM="darwinConfigurations.${SYSTEM_TYPE}.system"

export NIXPKGS_ALLOW_UNFREE=1

# Bump the packages built from overlays/ first — `nix flake update` never
# touches those, so without this they stay pinned forever. Non-fatal on
# purpose: a failed bump (offline, upstream down, rate-limited) must not block
# a rebuild. SKIP_OVERLAY_UPDATE=1 skips it entirely.
if [ -z "$SKIP_OVERLAY_UPDATE" ]; then
  if ! "$(dirname "$0")/update-overlays"; then
    echo "${YELLOW}Overlay update failed - building with the pinned versions.${NC}"
  fi
fi

echo "${YELLOW}Starting build...${NC}"
nix --extra-experimental-features 'nix-command flakes' build .#$FLAKE_SYSTEM $@

echo "${YELLOW}Switching to new generation...${NC}"
# See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
sudo ./result/sw/bin/darwin-rebuild switch --flake .#${SYSTEM_TYPE} $@

echo "${YELLOW}Cleaning up...${NC}"
unlink ./result

echo "${GREEN}Switch to new generation complete!${NC}"
