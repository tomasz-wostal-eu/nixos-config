#!/usr/bin/env bash
# Offline check before a push (DW-231): shellcheck on all tracked shell scripts. `nix flake check`
# and builds are left out on purpose (minutes, network).
# Bypass: git push --no-verify, or NC_HOOKS_SKIP=1. A missing tool is a skip, never a block.
set -eu

[ "${NC_HOOKS_SKIP:-}" = "1" ] && exit 0
cd "$(git rev-parse --show-toplevel)"

# a branch deletion pushes the all-zero local sha; nothing to check then
zero=0000000000000000000000000000000000000000
all_deletes=1
while read -r _ local_sha _ _; do
  [ "$local_sha" = "$zero" ] || all_deletes=0
done
[ "$all_deletes" = 0 ] || exit 0

NC_SKIP_MISSING=1 tests/shell/check.sh || { echo "pre-push: shellcheck failed" >&2; exit 1; }
